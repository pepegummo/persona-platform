# Copy to .env and fill in. Never commit .env.

# --- Infra ---
SECRET_KEY=change-me-in-production   # signs the anonymous visitor cookie
DATABASE_URL=postgresql+asyncpg://persona:persona@localhost:5432/persona
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000

# --- Auth (Clerk) ---
# Clerk dashboard → API keys. JWKS URL is https://<frontend-api>/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# optional, e.g. https://xxx.clerk.accounts.dev
CLERK_ISSUER=
# Local dev without Clerk: api accepts `Authorization: Bearer dev:<id>`; web sends it when
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is unset. Ignored when APP_ENV=production.
APP_ENV=development
AUTH_DEV_BYPASS=true

# --- LLM providers (keys live only on the backend) ---
# LLM_PROVIDER=fake runs the app with a built-in fake model (no keys, $0) for local demos.
LLM_PROVIDER=litellm
ANTHROPIC_API_KEY=
# optional: fallback provider / judge from a different model family
OPENAI_API_KEY=
# optional: if using a Cohere embedding model
COHERE_API_KEY=
# free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# free tier: https://console.groq.com/keys
GROQ_API_KEY=

# --- Model routing (LiteLLM model strings; check provider docs for current model names) ---
MODEL_COMPILE=anthropic/claude-sonnet-5
MODEL_SYNTH_REWRITE=anthropic/claude-sonnet-5
# X1 only
MODEL_STYLE_EXPAND=anthropic/claude-sonnet-5
MODEL_SHAPE_CLASSIFY=anthropic/claude-haiku-4-5-20251001
MODEL_CHAT_SIMPLE=anthropic/claude-haiku-4-5-20251001
MODEL_CHAT_LIKE_ME=anthropic/claude-sonnet-5
MODEL_MODERATION=anthropic/claude-haiku-4-5-20251001
# LLM-classifier moderation on every message (M4a)
MODERATION_ENABLED=true
# Keep comments on their own line: Docker / Cloud Run env files do not strip inline comments.
# e.g. openai/<strong-model>; different family than the generator if possible.
# If it equals MODEL_FALLBACK, the judge falls back to MODEL_COMPILE instead.
MODEL_JUDGE=
# e.g. openai/<fast-model>; used when the primary fails (after one retry on 429/5xx/timeout),
# including a retired model or bad key. Not used for bad requests (400).
MODEL_FALLBACK=
LLM_TIMEOUT_S=60

# Example only — evaluate Thai retrieval quality before choosing. EMBEDDING_DIM must match db schema.
# `fake/hash` = deterministic local vectors, no provider call (fine until M5 Like Me retrieval).
EMBEDDING_MODEL=cohere/embed-multilingual-v3.0
EMBEDDING_DIM=1024

# --- Free-tier profile ($0): Gemini primary (best Thai among free models), Groq fallback on 429 ---
# Uncomment these to override the Anthropic defaults above. Needs GEMINI_API_KEY and GROQ_API_KEY.
# MODEL_COMPILE=gemini/gemini-3.5-flash
# MODEL_SYNTH_REWRITE=gemini/gemini-3.5-flash
# MODEL_SHAPE_CLASSIFY=gemini/gemini-3.5-flash-lite
# MODEL_CHAT_SIMPLE=gemini/gemini-3.5-flash-lite
# MODEL_CHAT_LIKE_ME=gemini/gemini-3.5-flash
# MODEL_MODERATION=gemini/gemini-3.5-flash-lite
# Judge: different family than the generator. Qwen reasoning is turned off by the provider.
# MODEL_JUDGE=groq/qwen/qwen3.8-27b
# MODEL_FALLBACK=groq/qwen/qwen3.8-27b
# EMBEDDING_MODEL=fake/hash

# --- Feature flags (all false in Phase 1A Lean MVP) ---
FEATURE_EVAL=false
FEATURE_SYNTH_REWRITE=false
FEATURE_LIKE_ME=false
FEATURE_EXPORT=false

# --- Limits ---
RATE_LIMIT_VISITOR_PER_MIN=10
RATE_LIMIT_VISITOR_PER_DAY=100
RATE_LIMIT_PERSONA_PER_DAY=2000
DEFAULT_CREATOR_DAILY_SPEND_USD=1.00

# --- Guardrails ---
LEAK_NGRAM_SIZE=8
LEAK_THRESHOLD=0.35
