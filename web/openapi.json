          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{1,38}[a-z0-9])?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
