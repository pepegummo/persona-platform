        "required": [
          "id",
          "slug",
          "visibility",
          "display_name",
          "description",
          "mode",
          "status",
          "version_number",
          "example_count",
          "published_version_id",
          "updated_at"
        ],
        "title": "PersonaListItem"
      },
      "PersonaOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
