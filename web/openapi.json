        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
            ],
            "title": "Visibility"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simple",
              "like_me"
            ],
            "title": "Mode"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "compiling",
              "ready",
              "failed"
