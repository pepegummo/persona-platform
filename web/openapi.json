  "components": {
    "schemas": {
      "ExampleCreate": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Answer"
          },
          "is_private": {
            "type": "boolean",
            "title": "Is Private",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "ExampleCreate"
      },
      "ExampleOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "shape": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "comparison",
                  "how_to",
                  "definition",
                  "troubleshooting",
                  "opinion",
                  "recommendation",
                  "casual",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Shape"
          },
          "is_private": {
            "type": "boolean",
            "title": "Is Private"
          },
          "is_held_out": {
            "type": "boolean",
            "title": "Is Held Out"
          },
          "synthetic_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synthetic Of"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "shape",
          "is_private",
          "is_held_out",
          "synthetic_of",
          "created_at"
        ],
        "title": "ExampleOut"
      },
      "ExampleUpdate": {
        "properties": {
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "is_private": {
            "anyOf": [
              {
                "type": "boolean"
