              {
                "type": "null"
              }
            ],
            "title": "Is Private"
          }
        },
        "type": "object",
        "title": "ExampleUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
