        "properties": {
          "status": {
            "type": "string",
            "const": "degraded",
            "title": "Status",
            "default": "degraded"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "db",
          "redis"
        ],
        "title": "HealthDegraded"
      },
      "HealthOk": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthOk"
      },
      "PersonaCreate": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{1,38}[a-z0-9])?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "settings": {
            "$ref": "#/components/schemas/PersonaSettings"
          },
          "rules": {
            "type": "string",
            "maxLength": 4000,
            "title": "Rules",
            "default": ""
          },
          "mode": {
            "type": "string",
            "enum": [
              "simple",
              "like_me"
            ],
            "title": "Mode",
            "default": "simple"
          }
        },
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "PersonaCreate"
      },
